// Configuration Cloudflare : les fichiers de l'appli + le petit serveur (worker.js) : reconnaissance vocale,
// contenu réservé aux acheteurs et récepteur Hotmart. Toutes les demandes passent d'abord par worker.js.
{
  "name": "evoalafrench",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" }
}
